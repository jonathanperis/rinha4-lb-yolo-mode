---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/home/Navbar.astro';
import Footer from '@/components/home/Footer.astro';

let comparison: any = null;
try {
  comparison = (await import('../../../public/comparison/latest.json')).default;
} catch {
  comparison = null;
}
const participants = comparison?.participants ?? [];
const rows = Array.isArray(participants) ? participants : [];
const fmt = (value: any) => value === undefined || value === null || value === '' ? '—' : String(value);
const score = (row: any) => fmt(row.final_score ?? row.score ?? row.summary?.final_score);
const p99 = (row: any) => fmt(row.p99 ?? row.summary?.p99);
const failures = (row: any) => fmt(row.failure_rate ?? row.failures ?? row.summary?.failure_rate);
const errors = (row: any) => fmt(row.http_errors ?? row.summary?.http_errors);
---

<BaseLayout title="rinha4-lb-yolo-mode | Comparison Reports">
  <Navbar />
  <main>
    <section class="reports-hero">
      <p class="eyebrow">LB COMPARISON ARCHIVE</p>
      <h1>C BASELINE VS ASM CHALLENGER.</h1>
      <p class="tagline">
        Official-like workflow summaries compare dotnet, C, and assembly Rinha4 stacks while swapping the shared C YOLO LB and the assembly LB candidate.
      </p>
    </section>

    {comparison ? (
      <section class="report-table-wrap">
        <p>Source summary: <code>docs/public/comparison/latest.json</code>. Generated: <code>{fmt(comparison.generated_at ?? comparison.timestamp)}</code>.</p>
        <div class="report-scroll">
          <table class="report-table">
            <thead>
              <tr>
                <th>Participant</th>
                <th class="num">p99</th>
                <th class="num">Failures</th>
                <th class="num">Score</th>
                <th class="num">HTTP</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td><code>{fmt(row.participant ?? row.name)}</code></td>
                  <td class="num">{p99(row)}</td>
                  <td class="num danger-text">{failures(row)}</td>
                  <td class="num">{score(row)}</td>
                  <td class="num">{errors(row)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ) : (
      <section class="panel">
        <h2>No comparison summary yet</h2>
        <p>
          The Pages build expects <code>comparison-results/latest.json</code> from the benchmark workflow; when present, the deploy workflow copies it to <code>docs/public/comparison/latest.json</code> before building.
        </p>
      </section>
    )}
  </main>
  <Footer />
</BaseLayout>
